function grafic(robot_name, q, qd, qdd, seg_bounds)
% PLOT_UNIFIED_PROFILES Crea gráficos estandarizados por MUESTRAS.
%
% ENTRADAS:
%   robot_name: String con el nombre del robot (ej: 'R1')
%   q:          Matriz de posiciones (Nx6)
%   qd:         Matriz de velocidades (Nx6)
%   qdd:        Matriz de aceleraciones (Nx6). Usar [] si no está disponible.
%   seg_bounds: Vector (1xM) con los ÍNDICES de muestra donde terminan 
%               los segmentos (para líneas verticales). Usar [] si no hay.

if nargin < 4
    qdd = [];
end
if nargin < 5
    seg_bounds = [];
end

% --- Generar eje X basado en muestras ---
num_muestras = size(q, 1);
x_axis = 1:num_muestras;

% Determinar cuántos subplots se necesitan
has_qdd = ~isempty(qdd);
num_plots = 2 + has_qdd; % 2 (para q, qd) o 3 (si qdd existe)

% --- Crear Figura ---
fig_name = sprintf('%s - Perfiles de Trayectoria Unificados', robot_name);
fig = figure('Name', fig_name, 'NumberTitle', 'off');
clf(fig);

colors = lines(6);
labels = arrayfun(@(i) sprintf('q%d',i), 1:6, 'UniformOutput', false);

% --- 1. Gráfico de Posición (q) ---
ax1 = subplot(num_plots, 1, 1);
hold on; grid on;
plot(x_axis, q, 'LineWidth', 1.2); % <-- MODIFICADO
title('Posiciones Articulares');
xlabel('Muestras'); % <-- MODIFICADO
ylabel('Posición (rad)');
legend(labels{:}, 'Location','best');
% Dibujar líneas de segmento
for i = 1:numel(seg_bounds)
    xline(seg_bounds(i), 'r--', 'HandleVisibility','off'); % <-- MODIFICADO
end
hold off;

% --- 2. Gráfico de Velocidad (qd) ---
ax2 = subplot(num_plots, 1, 2);
hold on; grid on;
plot(x_axis, qd, 'LineWidth', 1.2); % <-- MODIFICADO
title('Velocidades Articulares');
xlabel('Muestras'); % <-- MODIFICADO
ylabel('Velocidad (rad/s)');
legend(labels{:}, 'Location','best');
% Dibujar líneas de segmento
for i = 1:numel(seg_bounds)
    xline(seg_bounds(i), 'r--', 'HandleVisibility','off'); % <-- MODIFICADO
end
hold off;

% --- 3. Gráfico de Aceleración (qdd) (Opcional) ---
if has_qdd
    ax3 = subplot(num_plots, 1, 3);
    hold on; grid on;
    plot(x_axis, qdd, 'LineWidth', 1.2); % <-- MODIFICADO
    title('Aceleraciones Articulares');
    xlabel('Muestras'); % <-- MODIFICADO
    ylabel('Aceleración (rad/s^2)');
    legend(labels{:}, 'Location','best');
    % Dibujar líneas de segmento
    for i = 1:numel(seg_bounds)
        xline(seg_bounds(i), 'r--', 'HandleVisibility','off'); % <-- MODIFICADO
    end
    hold off;
    
    linkaxes([ax1, ax2, ax3], 'x');
else
    linkaxes([ax1, ax2], 'x');
end

% Título general
sgtitle(fig_name);
drawnow;
end